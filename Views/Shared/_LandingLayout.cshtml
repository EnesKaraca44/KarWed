<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AniYakala Clone</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        :root {
            --primary: #FF5A5F; /* Coral/Redish like aniyakala */
            --dark: #1A1A1A;
            --light: #F9F9F9;
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--dark);
        }
        .navbar-brand {
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--primary) !important;
        }
        .btn-primary-custom {
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s;
        }
        .btn-primary-custom:hover {
            background-color: #E0484D;
            transform: translateY(-2px);
            color: white;
        }
        .hero-section {
            padding: 100px 0;
            background: linear-gradient(135deg, #FFF5F5 0%, #FFFFFF 100%);
        }
        .feature-icon {
            width: 60px;
            height: 60px;
            background: rgba(255, 90, 95, 0.1);
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            font-size: 24px;
            margin-bottom: 20px;
        }
        .step-number {
            font-size: 4rem;
            font-weight: 800;
            color: rgba(0,0,0,0.05);
            position: absolute;
            top: -20px;
            left: 0;
            z-index: -1;
        }
        .step-card {
            position: relative;
            z-index: 1;
        }
    </style>
</head>
<body>
    <style>
        .navbar-custom {
            background-color: #fdfbf7; /* Light beige / Off-white */
            background: #fdfbf7; 
            padding: 15px 0;
            box-shadow: 0 2px 15px rgba(0,0,0,0.05);
        }
        .navbar-custom .navbar-brand {
            font-weight: 800;
            font-size: 1.8rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .navbar-custom .nav-link {
            color: #555 !important;
            font-weight: 600;
            margin: 0 10px;
            transition: color 0.3s;
        }
        .navbar-custom .nav-link:hover {
            color: #764ba2 !important;
        }
        .btn-nav-login {
            color: #555 !important;
            font-weight: 600;
            text-decoration: none;
            margin-right: 15px;
            transition: color 0.3s;
        }
        .btn-nav-login:hover {
            color: #764ba2 !important;
        }
        .btn-nav-cta {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white !important;
            border: none;
            padding: 10px 25px;
            border-radius: 8px;
            font-weight: 700;
            box-shadow: 0 4px 10px rgba(118, 75, 162, 0.3);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-nav-cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(118, 75, 162, 0.4);
        }
        /* Mobile toggler fix for light background */
        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(0, 0, 0, 0.55)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e") !important;
        }
    </style>

    <nav class="navbar navbar-expand-lg navbar-dark fixed-top shadow-sm navbar-custom">
        <div class="container-fluid px-lg-5">
            <a class="navbar-brand" href="/">KarWedding</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto align-items-center">
                    <li class="nav-item"><a class="nav-link" href="/">Ana Sayfa</a></li>
                    <li class="nav-item"><a class="nav-link" href="#nasil-calisir">Nasıl Çalışır?</a></li>
                    <li class="nav-item"><a class="nav-link" href="#kullanim-alanlari">Kullanım Alanları</a></li>
                    <li class="nav-item"><a class="nav-link" href="#fiyatlandirma">Fiyatlandırma</a></li>
                </ul>
                <div class="d-flex align-items-center mt-3 mt-lg-0">
                    <a href="/Admin" class="btn-nav-login">Giriş Yap</a>
                    <a href="#nasil-calisir" class="btn btn-nav-cta">Hemen Başla!</a>
                </div>
            </div>
        </div>
    </nav>

    @RenderBody()

    <!-- Footer -->
    <style>
        .footer-new {
            background: linear-gradient(135deg, #141E30 0%, #243B55 100%); /* Deep Metallic Blue */
            color: white;
            padding: 80px 0 40px 0;
            position: relative;
            clip-path: polygon(0 15%, 100% 0, 100% 100%, 0 100%);
            margin-top: -20px; /* Overlap slightly */
        }
        .footer-logo {
            font-size: 2rem;
            font-weight: 800;
            color: white;
            letter-spacing: -1px;
            margin-bottom: 1rem;
        }
        .footer-link {
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            display: block;
            margin-bottom: 10px;
            transition: color 0.3s;
        }
        .footer-link:hover {
            color: white;
        }
        .payment-icons i {
            font-size: 1.5rem;
            margin-right: 15px;
            opacity: 0.8;
        }
    </style>

    <footer class="footer-new mt-5">
        <div class="container pt-5">
            <div class="row text-center text-md-start">
                <!-- Brand & Copyright -->
                <div class="col-md-4 mb-5 mb-md-0">
                    <div class="footer-logo">KarWedding</div>
                    <p class="small text-white-50 mb-4">© 2026 KarWedding. Tüm hakları saklıdır.</p>
                    <div class="payment-icons text-white">
                        <i class="bi bi-credit-card-2-front"></i>
                        <i class="bi bi-paypal"></i>
                        <i class="bi bi-bank"></i>
                    </div>
                </div>

                <!-- Contact -->
                <div class="col-md-4 mb-4 mb-md-0 text-center">
                    <h5 class="fw-bold mb-4">İletişim</h5>
                    <a href="#" class="footer-link">İletişim Formu</a>
                    <a href="mailto:hello@karwedding.com" class="footer-link">Mail: hello@karwedding.com</a>
                </div>

                <!-- More -->
                <div class="col-md-4 text-center text-md-end">
                    <h5 class="fw-bold mb-4">Daha Fazlası</h5>
                    <a href="#" class="footer-link">Hakkımızda</a>
                    <a href="#" class="footer-link">Kullanım Koşulları & Gizlilik</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
