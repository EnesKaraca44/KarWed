@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap - KarWedding</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #fdbd65 100%); /* Matching Landing Navbar/Hero vibe */
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        .login-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            overflow: hidden;
            width: 900px;
            max-width: 95%;
            min-height: 550px;
            display: flex;
        }

        .login-form-side {
            padding: 50px;
            width: 50%;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .login-brand-side {
            width: 50%;
            background: linear-gradient(135deg, #8E2DE2 0%, #4A00E0 100%); /* Deep Purple Gradient */
            color: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 40px;
            position: relative;
        }
        
        /* Make the brand side gradient match the reference more closely (lighter purple/blue) */
        .login-brand-side {
             background: linear-gradient(135deg, #7F7FD5 0%, #86A8E7 50%, #91EAE4 100%); 
             background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .form-control {
            border-radius: 10px;
            padding: 12px 15px;
            border: 1px solid #eee;
            background-color: #f9f9f9;
        }
        .form-control:focus {
            box-shadow: none;
            border-color: #764ba2;
            background-color: white;
        }
        
        .btn-login {
            background: linear-gradient(to right, #667eea, #764ba2);
            border: none;
            color: white;
            padding: 12px;
            border-radius: 10px;
            font-weight: 600;
            width: 100%;
            margin-top: 10px;
            transition: opacity 0.3s;
        }
        .btn-login:hover {
            opacity: 0.9;
            color: white;
        }

        .btn-google {
            background: white;
            border: 1px solid #ddd;
            color: #333;
            padding: 12px;
            border-radius: 10px;
            font-weight: 600;
            width: 100%;
            margin-top: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: background 0.3s;
        }
        .btn-google:hover {
            background-color: #f1f1f1;
        }

        .brand-title {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 10px;
        }
        
        .btn-signup-switch {
            background: transparent;
            border: 2px solid white;
            color: white;
            padding: 10px 30px;
            border-radius: 50px;
            font-weight: 600;
            margin-top: 20px;
            transition: all 0.3s;
        }
        .btn-signup-switch:hover {
            background: white;
            color: #764ba2;
        }

        @@media (max-width: 768px) {
            .login-card {
                flex-direction: column;
                height: auto;
            }
            .login-form-side, .login-brand-side {
                width: 100%;
                padding: 30px;
            }
            .login-brand-side {
                order: -1; /* Show brand on top on mobile */
                padding: 40px 20px;
            }
        }
    </style>
</head>
<body>

    <div class="login-card">
        <!-- Left Side: Login Form -->
        <div class="login-form-side">
            <h2 class="fw-bold text-center mb-4" style="color: #764ba2;">Giriş Yap</h2>
            
            <form action="/Account/Login" method="post">
                <div class="mb-3">
                    <label class="form-label text-muted small">E-posta</label>
                    <input type="email" name="email" class="form-control" placeholder="ornek@email.com" required>
                </div>
                
                <div class="mb-3 position-relative">
                    <label class="form-label text-muted small">Şifre</label>
                    <input type="password" name="password" class="form-control" placeholder="******" required>
                    <i class="bi bi-eye-slash position-absolute" style="right: 15px; top: 38px; cursor: pointer; color: #aaa;"></i>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="rememberMe">
                        <label class="form-check-label small text-muted" for="rememberMe">Beni Hatırla</label>
                    </div>
                    <a href="#" class="small text-decoration-none" style="color: #764ba2;">Şifreni mi unuttun?</a>
                </div>

                <button type="submit" class="btn-login shadow-sm">Giriş Yap</button>
            </form>

            <form asp-action="ExternalLogin" asp-controller="Account" method="post" class="w-100">
                <input type="hidden" name="provider" value="Google" />
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <button type="submit" class="btn-google">
                    <img src="https://www.svgrepo.com/show/475656/google-color.svg" width="20" alt="Google">
                    Google ile Giriş Yap
                </button>
            </form>
        </div>

        <!-- Right Side: Brand & Signup -->
        <div class="login-brand-side">
            <div class="brand-title">
                 <i class="bi bi-stars"></i> KarWedding
            </div>
            <p class="mb-4 opacity-75">Düğün albümünüzü dijitalleştirin.</p>
            
            <div class="mt-4">
                <p class="mb-2">Hesabın yok mu?</p>
                <a href="/Account/Register" class="btn-signup-switch">Hemen Başla!</a>
            </div>
        </div>
    </div>

</body>
</html>
