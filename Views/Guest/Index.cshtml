@model IEnumerable<dugunsalonu.Models.GuestEntry>

@{
    Layout = null;
    var weddingEvent = ViewBag.Event as dugunsalonu.Models.WeddingEvent;
    var isStorageExpired = ViewBag.IsStorageExpired as bool? ?? false;
    var storageEndDate = ViewBag.StorageEndDate as DateTime?;
    var photoCount = Model.Count(e => e.PhotoPath != null && (e.PhotoPath.EndsWith(".jpg") || e.PhotoPath.EndsWith(".png") || e.PhotoPath.EndsWith(".jpeg")));
    var videoCount = Model.Count(e => e.PhotoPath != null && (e.PhotoPath.EndsWith(".mp4") || e.PhotoPath.EndsWith(".mov")));
    var messageCount = Model.Count(e => !string.IsNullOrEmpty(e.Message));
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@weddingEvent?.CoupleName - Dijital Albüm</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
        :root {
            --primary: #7c5cbf;
            --primary-light: #a78bfa;
            --accent: #ec4899;
            --bg-soft: #faf9fc;
            --card-bg: #ffffff;
            --text-dark: #1f2937;
            --text-muted: #6b7280;
            --shadow-sm: 0 2px 8px rgba(124, 92, 191, 0.08);
            --shadow-md: 0 8px 24px rgba(124, 92, 191, 0.12);
            --radius: 16px;
            --radius-lg: 24px;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(165deg, #faf9fc 0%, #f3f0f9 50%, #ede9fe 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            color: var(--text-dark);
            overflow-x: hidden;
            margin: 0;
        }

        .navbar-custom {
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255,255,255,0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(124, 92, 191, 0.08);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .brand-logo {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: white;
            padding: 8px 18px;
            border-radius: 12px;
            font-weight: 800;
            font-size: 1rem;
            text-decoration: none;
            letter-spacing: -0.02em;
            box-shadow: 0 4px 14px rgba(124, 92, 191, 0.35);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .brand-logo:hover { color: white; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(124, 92, 191, 0.4); }

        .lang-select {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 14px;
            border-radius: 10px;
            background: rgba(124, 92, 191, 0.06);
            transition: background 0.2s;
        }
        .lang-select:hover { color: var(--primary); background: rgba(124, 92, 191, 0.12); }

        .main-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 2rem 1rem 3rem;
            max-width: 1100px;
            margin: 0 auto;
        }

        .event-title {
            font-size: clamp(1.8rem, 5vw, 2.5rem);
            font-weight: 800;
            margin-bottom: 1rem;
            letter-spacing: -0.03em;
            background: linear-gradient(135deg, var(--text-dark) 0%, var(--primary) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .btn-upload {
            background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
            color: white;
            border: none;
            padding: 14px 36px;
            border-radius: 14px;
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 8px 24px rgba(124, 92, 191, 0.4);
        }
        .btn-upload:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(124, 92, 191, 0.45);
            color: white;
        }

        .stats-text {
            color: var(--text-muted);
            font-size: 0.95rem;
            font-weight: 500;
            margin-bottom: 1.5rem;
        }

        .filter-container {
            display: flex;
            gap: 8px;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            justify-content: center;
        }

        .filter-btn {
            background: rgba(255,255,255,0.8);
            border: 1px solid rgba(124, 92, 191, 0.15);
            color: var(--text-muted);
            padding: 10px 20px;
            font-weight: 500;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.25s ease;
            border-radius: 12px;
            backdrop-filter: blur(8px);
        }

        .filter-btn:hover:not(.active) {
            background: rgba(255,255,255,0.95);
            color: var(--primary);
            border-color: rgba(124, 92, 191, 0.3);
        }

        .filter-btn.active {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: white;
            border-color: transparent;
        }
        
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 16px;
            width: 100%;
        }
        
        .gallery-item {
            aspect-ratio: 1;
            background: var(--card-bg);
            border-radius: var(--radius);
            overflow: hidden;
            position: relative;
            box-shadow: var(--shadow-sm);
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .gallery-item:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-md);
            border-radius: var(--radius-lg);
        }
        
        .gallery-item img,
        .gallery-item video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }
        .gallery-item:hover img,
        .gallery-item:hover video {
            transform: scale(1.08);
        }

        .message-card {
            aspect-ratio: 1;
            background: linear-gradient(145deg, var(--primary) 0%, #5b4a8f 100%);
            border-radius: var(--radius);
            padding: 16px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            text-align: left;
            overflow: hidden;
            position: relative;
            box-shadow: var(--shadow-sm);
        }
        .message-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(ellipse at top right, rgba(255,255,255,0.15) 0%, transparent 60%);
            pointer-events: none;
        }
        .message-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-md);
        }
        .message-card .msg-text {
            font-size: 0.9rem;
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 4;
            -webkit-box-orient: vertical;
            overflow: hidden;
            color: rgba(255,255,255,0.95);
            position: relative;
        }
        .message-card .msg-author {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.7);
            margin-top: 10px;
            font-weight: 500;
        }

        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--text-muted);
        }
        .empty-state i { font-size: 4rem; margin-bottom: 1rem; opacity: 0.4; }

        /* Lightbox */
        .lightbox {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.92);
            z-index: 9999;
            align-items: center;
            justify-content: center;
            padding: 20px;
            cursor: pointer;
        }
        .lightbox.active {
            display: flex;
        }
        .lightbox-content {
            max-width: 95vw;
            max-height: 95vh;
            object-fit: contain;
            cursor: default;
        }
        .lightbox-content img,
        .lightbox-content video {
            max-width: 95vw;
            max-height: 90vh;
            object-fit: contain;
            border-radius: 12px;
        }
        .lightbox-close {
            position: fixed;
            top: 20px;
            right: 24px;
            width: 44px;
            height: 44px;
            background: rgba(255,255,255,0.15);
            border: none;
            border-radius: 12px;
            color: white;
            font-size: 1.5rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            transition: background 0.2s;
        }
        .lightbox-close:hover {
            background: rgba(255,255,255,0.25);
        }
        .lightbox-msg {
            background: linear-gradient(145deg, var(--primary) 0%, #5b4a8f 100%);
            padding: 2rem;
            border-radius: 20px;
            max-width: 400px;
            color: white;
            text-align: left;
        }
        .lightbox-msg .msg-text { font-size: 1.1rem; line-height: 1.6; }
        .lightbox-msg .msg-author { font-size: 0.9rem; opacity: 0.8; margin-top: 1rem; }
        .gallery-item { cursor: pointer; }

        .lightbox-nav {
            position: fixed;
            top: 50%;
            transform: translateY(-50%);
            width: 56px;
            height: 56px;
            background: rgba(255,255,255,0.15);
            border: none;
            border-radius: 50%;
            color: white;
            font-size: 1.5rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10001;
            transition: all 0.2s;
        }
        .lightbox-nav:hover { background: rgba(255,255,255,0.28); }
        .lightbox-nav:disabled { opacity: 0.3; cursor: not-allowed; pointer-events: none; }
        .lightbox-prev { left: 20px; }
        .lightbox-next { right: 20px; }
        .lightbox-counter {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            color: rgba(255,255,255,0.85);
            font-size: 0.95rem;
            font-weight: 500;
            z-index: 10001;
        }
    </style>
</head>
<body>

    <div class="navbar-custom">
        <a href="/" class="brand-logo">KarWedding</a>
        <a href="#" class="lang-select">TR <i class="bi bi-chevron-down small"></i></a>
    </div>

    <div class="main-content">
        <h1 class="event-title">@weddingEvent?.CoupleName</h1>
        
        @if (!isStorageExpired)
        {
            <a href="/event/@weddingEvent?.Slug/upload" class="btn-upload"><i class="bi bi-cloud-arrow-up-fill"></i> Albüme Yükle</a>
        }

        @if (!isStorageExpired)
        {
        <div class="stats-text">
            @photoCount fotoğraf, @messageCount mesaj ve @videoCount video
        </div>

        <div class="filter-container">
            <button class="filter-btn active" data-filter="all">Hepsi</button>
            <button class="filter-btn" data-filter="photo">Fotoğraflar</button>
            <button class="filter-btn" data-filter="video">Videolar</button>
            <button class="filter-btn" data-filter="message">Mesajlar</button>
        </div>
        }
        
        @if (Model.Any())
        {
            <div class="gallery-grid" id="galleryGrid">
                @foreach(var item in Model)
                {
                    @if (!string.IsNullOrEmpty(item.PhotoPath))
                    {
                        var isVideo = item.PhotoPath.EndsWith(".mp4") || item.PhotoPath.EndsWith(".mov");
                        <div class="gallery-item" data-type="@(isVideo ? "video" : "photo")" data-src="@item.PhotoPath" data-lightbox>
                            @if (isVideo)
                            {
                                <video src="@item.PhotoPath" muted playsinline style="width:100%;height:100%;object-fit:cover;"></video>
                            }
                            else
                            {
                                <img src="@item.PhotoPath" alt="Guest Photo">
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(item.Message))
                    {
                        <div class="message-card gallery-item" data-type="message" data-message="@item.Message" data-author="@(item.GuestName ?? "Misafir")" data-lightbox>
                            <div class="msg-text">@item.Message</div>
                            <div class="msg-author">— @(item.GuestName ?? "Misafir")</div>
                        </div>
                    }
                }
            </div>
        }
        else if (isStorageExpired)
        {
            <div class="empty-state">
                <i class="bi bi-clock-history d-block"></i>
                <p class="mb-0"><strong>Depolama süresi dolmuştur.</strong></p>
                <p class="small mb-0 mt-1">Bu etkinliğin içerikleri artık görüntülenememektedir.</p>
                @if (storageEndDate.HasValue)
                {
                    <p class="small text-muted mt-1">Depolama son tarihi: @storageEndDate.Value.ToString("dd.MM.yyyy")</p>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-images d-block"></i>
                <p class="mb-0">Henüz paylaşım yok. İlk fotoğrafı sen yükle!</p>
            </div>
        }
    </div>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox">
        <button class="lightbox-close" id="lightboxClose" aria-label="Kapat"><i class="bi bi-x-lg"></i></button>
        <button class="lightbox-nav lightbox-prev" id="lightboxPrev" aria-label="Önceki"><i class="bi bi-chevron-left"></i></button>
        <div class="lightbox-content" id="lightboxContent"></div>
        <button class="lightbox-nav lightbox-next" id="lightboxNext" aria-label="Sonraki"><i class="bi bi-chevron-right"></i></button>
        <div class="lightbox-counter" id="lightboxCounter"></div>
    </div>

    <script>
        document.querySelectorAll('.filter-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
                this.classList.add('active');
                var filter = this.getAttribute('data-filter');
                var grid = document.getElementById('galleryGrid');
                if (grid) {
                    grid.querySelectorAll('[data-type]').forEach(function(el) {
                        var type = el.getAttribute('data-type');
                        el.style.display = (filter === 'all' || type === filter) ? '' : 'none';
                    });
                }
            });
        });

        var lightbox = document.getElementById('lightbox');
        var lightboxContent = document.getElementById('lightboxContent');
        var lightboxVideo = null;
        var galleryItems = [];
        var currentIndex = 0;

        function getVisibleItems() {
            var grid = document.getElementById('galleryGrid');
            if (!grid) return [];
            return [].slice.call(grid.querySelectorAll('[data-lightbox]')).filter(function(el) { return el.style.display !== 'none'; });
        }

        function showItem(index) {
            if (index < 0 || index >= galleryItems.length) return;
            currentIndex = index;
            var el = galleryItems[currentIndex];
            lightboxContent.innerHTML = '';
            if (lightboxVideo) { lightboxVideo.pause(); lightboxVideo = null; }
            var type = el.getAttribute('data-type');
            if (type === 'photo') {
                lightboxContent.innerHTML = '<img src="' + el.getAttribute('data-src') + '" alt="Fotoğraf">';
            } else if (type === 'video') {
                lightboxVideo = document.createElement('video');
                lightboxVideo.src = el.getAttribute('data-src');
                lightboxVideo.controls = true;
                lightboxVideo.autoplay = true;
                lightboxVideo.style.width = '100%';
                lightboxVideo.style.maxHeight = '90vh';
                lightboxContent.appendChild(lightboxVideo);
            } else if (type === 'message') {
                var msgDiv = document.createElement('div');
                msgDiv.className = 'lightbox-msg';
                msgDiv.innerHTML = '<div class="msg-text"></div><div class="msg-author"></div>';
                msgDiv.querySelector('.msg-text').textContent = el.getAttribute('data-message') || '';
                msgDiv.querySelector('.msg-author').textContent = '— ' + (el.getAttribute('data-author') || 'Misafir');
                lightboxContent.appendChild(msgDiv);
            }
            document.getElementById('lightboxPrev').disabled = index <= 0;
            document.getElementById('lightboxNext').disabled = index >= galleryItems.length - 1;
            document.getElementById('lightboxCounter').textContent = (index + 1) + ' / ' + galleryItems.length;
        }

        function openLightbox(el) {
            galleryItems = getVisibleItems();
            var idx = galleryItems.indexOf(el);
            currentIndex = idx >= 0 ? idx : 0;
            showItem(currentIndex);
            lightbox.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            lightbox.classList.remove('active');
            document.body.style.overflow = '';
            if (lightboxVideo) { lightboxVideo.pause(); lightboxVideo = null; }
        }

        function goPrev() { if (currentIndex > 0) showItem(currentIndex - 1); }
        function goNext() { if (currentIndex < galleryItems.length - 1) showItem(currentIndex + 1); }

        document.querySelectorAll('[data-lightbox]').forEach(function(el) {
            el.addEventListener('click', function() { openLightbox(el); });
        });
        document.getElementById('lightboxClose').addEventListener('click', function(e) { e.stopPropagation(); closeLightbox(); });
        document.getElementById('lightboxPrev').addEventListener('click', function(e) { e.stopPropagation(); goPrev(); });
        document.getElementById('lightboxNext').addEventListener('click', function(e) { e.stopPropagation(); goNext(); });
        lightbox.addEventListener('click', function(e) { if (e.target === lightbox) closeLightbox(); });
        document.addEventListener('keydown', function(e) {
            if (!lightbox.classList.contains('active')) return;
            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowLeft') goPrev();
            if (e.key === 'ArrowRight') goNext();
        });

        var touchStartX = 0, touchEndX = 0;
        lightbox.addEventListener('touchstart', function(e) { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
        lightbox.addEventListener('touchend', function(e) {
            touchEndX = e.changedTouches[0].screenX;
            var diff = touchStartX - touchEndX;
            if (Math.abs(diff) > 50) { if (diff > 0) goNext(); else goPrev(); }
        }, { passive: true });
    </script>
</body>
</html>
