@{
    Layout = null; // Standalone layout like Login
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hoş Geldin - KarWedding</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #fdbd65 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            color: #333;
        }

        .welcome-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
            padding: 3rem;
            text-align: center;
            max-width: 500px;
            width: 90%;
            /* Optional animation */
            animation: fadeIn 0.8s ease-out;
        }

        .icon-container {
            font-size: 5rem;
            color: #764ba2;
            margin-bottom: 2rem;
            /* Placeholder for the "Camera/Photos" illustration */
            display: inline-block;
            filter: drop-shadow(0 4px 6px rgba(118, 75, 162, 0.2));
        }

        h1 {
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 1rem;
        }

        p {
            color: #555;
            font-size: 1.1rem;
            margin-bottom: 2.5rem;
        }

        .btn-start {
            background: linear-gradient(to right, #667eea, #764ba2);
            border: none;
            color: white;
            padding: 1rem 3rem;
            border-radius: 12px;
            font-weight: 600;
            font-size: 1.1rem;
            transition: transform 0.2s, box-shadow 0.2s;
            width: 100%;
            margin-bottom: 1rem;
        }

        .btn-start:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(118, 75, 162, 0.3);
            color: white;
        }

        .btn-logout {
            background: transparent;
            border: none;
            color: #764ba2;
            font-weight: 600;
            padding: 0.5rem 1rem;
            transition: opacity 0.2s;
        }

        .btn-logout:hover {
            opacity: 0.7;
            text-decoration: underline;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <div class="welcome-card">
        <div class="icon-container">
            <!-- Using a camera icon as placeholder for the illustration -->
            <i class="bi bi-camera-fill"></i>
            <i class="bi bi-images position-absolute" style="font-size: 3rem; transform: rotate(15deg) translate(30px, -20px); color: #fdbd65;"></i>
        </div>
        
        <h1>Hoş geldin @User.Identity.Name!</h1>
        <p>Dijital Albümünü oluşturmaya başlayalım!</p>
        
        <a href="/Onboarding/SelectType" class="btn btn-start">Başla</a>
        
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="btn-logout">Çıkış Yap</button>
        </form>
    </div>

</body>
</html>
