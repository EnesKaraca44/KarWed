@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Etkinlik Seçimi - KarWedding</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #fdbd65 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            color: #333;
        }

        .select-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
            padding: 3rem;
            text-align: center;
            max-width: 800px;
            width: 90%;
            animation: fadeIn 0.8s ease-out;
        }

        .icon-container {
            font-size: 5rem;
            color: #fdbd65;
            margin-bottom: 2rem;
            display: inline-block;
            filter: drop-shadow(0 4px 6px rgba(253, 189, 101, 0.3));
        }

        h1 {
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 2rem;
        }

        .event-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 15px;
            margin-bottom: 2rem;
        }

        .btn-event {
            background: white;
            border: 2px solid #eee;
            color: #555;
            padding: 1.5rem;
            border-radius: 16px;
            font-weight: 600;
            transition: all 0.2s;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }

        .btn-event:hover {
            border-color: #764ba2;
            color: #764ba2;
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(118, 75, 162, 0.15);
        }

        .btn-event i {
            font-size: 2rem;
            margin-bottom: 0.5rem;
            color: #764ba2;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .btn-back {
            color: #888;
            text-decoration: none;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: color 0.2s;
        }
        .btn-back:hover {
            color: #333;
        }
    </style>
</head>
<body>

    <div class="select-card">
        <div class="icon-container">
            <i class="bi bi-people-fill"></i>
            <i class="bi bi-stars position-absolute" style="font-size: 2rem; top: 0; right: -20px; color: #764ba2;"></i>
        </div>
        
        <h1>Nasıl bir etkinlik düzenliyorsun?</h1>
        
        <div class="event-grid">
            <a href="/Onboarding/EventDetails?type=Dugun" class="btn-event">
                <i class="bi bi-heart-fill"></i>
                Düğün
            </a>
            <a href="/Onboarding/EventDetails?type=Nisan" class="btn-event">
                <i class="bi bi-gem"></i>
                Nişan
            </a>
            <a href="/Onboarding/EventDetails?type=BekarligaVeda" class="btn-event">
                <i class="bi bi-music-note-beamed"></i>
                Bekarlığa Veda
            </a>
            <a href="/Onboarding/EventDetails?type=DogumGunu" class="btn-event">
                <i class="bi bi-gift-fill"></i>
                Doğum Günü
            </a>
            <a href="/Onboarding/EventDetails?type=Parti" class="btn-event">
                <i class="bi bi-balloon-fill"></i>
                Parti
            </a>
            <a href="/Onboarding/EventDetails?type=BabyShower" class="btn-event">
                <i class="bi bi-egg-fill"></i>
                Baby Shower
            </a>
            <a href="/Onboarding/EventDetails?type=Kurumsal" class="btn-event">
                <i class="bi bi-building"></i>
                Kurumsal
            </a>
            <a href="/Onboarding/EventDetails?type=Konferans" class="btn-event">
                <i class="bi bi-mic-fill"></i>
                Konferans
            </a>
            <a href="/Onboarding/EventDetails?type=Diger" class="btn-event">
                <i class="bi bi-three-dots"></i>
                Diğer
            </a>
        </div>
        
        <a href="/Onboarding/Welcome" class="btn-back">
            <i class="bi bi-arrow-left"></i> Geri Dön
        </a>
    </div>

</body>
</html>
