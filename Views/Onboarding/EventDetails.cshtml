@{
    Layout = null;
    var type = Context.Request.Query["type"].ToString();
    var title = "Etkinlik Adı";
    var placeholder = "Etkinlik Adı";
    var icon = "bi-stars";

    switch(type) {
        case "Dugun":
        case "Nisan":
            title = "Çift İsimleri";
            placeholder = "Örn: Ahmet & Ayşe";
            icon = "bi-heart-fill";
            break;
        case "DogumGunu":
            title = "Doğum Günü Sahibi";
            placeholder = "Örn: Ali'nin 1. Yaş Günü";
            icon = "bi-gift-fill";
            break;
        case "Kurumsal":
        case "Konferans":
            title = "Etkinlik Başlığı";
            placeholder = "Örn: Yıl Sonu Değerlendirme Toplantısı";
            icon = "bi-briefcase-fill";
            break;
        default:
            title = "Etkinlik Adı";
            placeholder = "Örn: Mezuniyet Partisi";
            icon = "bi-calendar-event";
            break;
    }
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Etkinlik Detayları - KarWedding</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #fdbd65 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            color: #333;
        }

        .details-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
            padding: 3rem;
            text-align: center;
            max-width: 500px;
            width: 90%;
            animation: slideUp 0.6s ease-out;
        }

        .icon-header {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #fdbd65 0%, #f79d00 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 2rem;
            color: white;
            font-size: 2.5rem;
            box-shadow: 0 10px 20px rgba(253, 189, 101, 0.4);
        }

        h2 {
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 0.5rem;
        }

        p.subtitle {
            color: #666;
            margin-bottom: 2rem;
        }

        .form-floating > .form-control {
            border-radius: 12px;
            border: 2px solid #eee;
            padding-left: 20px;
        }
        
        .form-floating > .form-control:focus {
            border-color: #764ba2;
            box-shadow: 0 0 0 4px rgba(118, 75, 162, 0.1);
        }

        .btn-continue {
            background: linear-gradient(to right, #667eea, #764ba2);
            border: none;
            color: white;
            padding: 1rem 2rem;
            border-radius: 12px;
            font-weight: 600;
            font-size: 1.1rem;
            width: 100%;
            margin-top: 1.5rem;
            transition: all 0.3s;
        }

        .btn-continue:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(118, 75, 162, 0.3);
            color: white;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(40px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .btn-back-link {
            color: #999;
            text-decoration: none;
            font-size: 0.9rem;
            margin-top: 1.5rem;
            display: inline-block;
        }
        .btn-back-link:hover {
            color: #555;
        }
    </style>
</head>
<body>

    <div class="details-card">
        <div class="icon-header">
            <i class="bi @icon"></i>
        </div>
        
        <h2>Son bir adım!</h2>
        <p class="subtitle">Etkinliğin için güzel bir isim belirleyelim.</p>
        
        <form asp-action="CompleteSetup" method="post">
            <!-- Hidden Fields -->
            <input type="hidden" name="EventType" value="@type" />
            <input type="hidden" name="ThemeColor" value="#FFFFFF" />
            
            <div class="form-floating mb-3 text-start">
                <input type="text" class="form-control" id="coupleName" name="CoupleName" placeholder="@placeholder" required autofocus>
                <label for="coupleName">@title</label>
            </div>

            <div class="form-floating mb-3 text-start">
                <input type="date" class="form-control" id="eventDate" name="EventDate" required value="@DateTime.Now.ToString("yyyy-MM-dd")">
                <label for="eventDate">Etkinlik Tarihi</label>
            </div>

            <button type="submit" class="btn-continue">
                Etkinliği Oluştur <i class="bi bi-arrow-right ms-2"></i>
            </button>
        </form>
        
        <a href="/Onboarding/SelectType" class="btn-back-link">
            <i class="bi bi-arrow-left"></i> Geri Dön
        </a>
    </div>

</body>
</html>
